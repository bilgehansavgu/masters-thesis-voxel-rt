# Plugin sockets.
#
# A socket is an extension point with a registry (for example the tracer socket). A plugin is a
# library that provides one C++ function `void <FUNCTION>(<Registry>&)` in namespace
# thesis::plugins, which adds itself to the registry.
#
# Adding a plugin = a new folder + one thesis_register_plugin() call in its CMakeLists.txt.
# No existing C++ file is edited: the function that calls every registration is generated here.
# (Self-registering static objects are avoided on purpose: linkers drop them from static libraries.)

function(thesis_register_plugin)
    cmake_parse_arguments(ARG "" "SOCKET;TARGET;FUNCTION" "" ${ARGN})
    if(NOT ARG_SOCKET OR NOT ARG_TARGET OR NOT ARG_FUNCTION)
        message(FATAL_ERROR "thesis_register_plugin needs SOCKET, TARGET and FUNCTION")
    endif()
    set_property(GLOBAL APPEND PROPERTY THESIS_${ARG_SOCKET}_PLUGIN_TARGETS ${ARG_TARGET})
    set_property(GLOBAL APPEND PROPERTY THESIS_${ARG_SOCKET}_PLUGIN_FUNCTIONS ${ARG_FUNCTION})
    # The plugin's include/ folder, for shaders compiled elsewhere that read the plugin's
    # <Name>Shared.h (see thesis_add_shaders PER_PRIMITIVE).
    if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/include")
        set_property(GLOBAL APPEND PROPERTY THESIS_${ARG_SOCKET}_PLUGIN_INCLUDE_DIRS
            "${CMAKE_CURRENT_SOURCE_DIR}/include")
    endif()
endfunction()

# thesis_generate_plugin_registration(SOCKET <name> TARGET <library> REGISTRY_HEADER <header>
#                                     REGISTRY_TYPE <type> ENTRY <function>)
#
# Generates `void thesis::plugins::<ENTRY>(<REGISTRY_TYPE>&)`, which calls every function
# registered for SOCKET, adds it to TARGET and links TARGET against all plugin libraries.
# Must run after every plugin directory has been added.
function(thesis_generate_plugin_registration)
    cmake_parse_arguments(ARG "" "SOCKET;TARGET;REGISTRY_HEADER;REGISTRY_TYPE;ENTRY" "" ${ARGN})
    get_property(plugin_targets GLOBAL PROPERTY THESIS_${ARG_SOCKET}_PLUGIN_TARGETS)
    get_property(plugin_functions GLOBAL PROPERTY THESIS_${ARG_SOCKET}_PLUGIN_FUNCTIONS)

    set(declarations "")
    set(calls "")
    foreach(function_name IN LISTS plugin_functions)
        string(APPEND declarations "void ${function_name}(${ARG_REGISTRY_TYPE}& registry);\n")
        string(APPEND calls "    ${function_name}(registry);\n")
    endforeach()

    set(output "${CMAKE_CURRENT_BINARY_DIR}/generated/${ARG_ENTRY}.cpp")
    file(CONFIGURE OUTPUT "${output}" CONTENT
"// Generated by cmake/ThesisPlugins.cmake. Do not edit.
#include \"${ARG_REGISTRY_HEADER}\"

namespace thesis::plugins {

${declarations}
void ${ARG_ENTRY}(${ARG_REGISTRY_TYPE}& registry)
{
${calls}}

} // namespace thesis::plugins
")
    target_sources(${ARG_TARGET} PRIVATE "${output}")
    target_link_libraries(${ARG_TARGET} PRIVATE ${plugin_targets})
endfunction()
