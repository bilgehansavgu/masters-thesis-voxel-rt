{
  "name": "thesis-renderer",
  "version-string": "0.1.0",
  "description": "Voxel ray tracing testbed: hardware vs software tracers behind one interface.",
  "builtin-baseline": "50c0cb48a0cf2f6fc5c7b2c0d2bafbe26d0a7ca2",
  "dependencies": [
    "vulkan",
    "vk-bootstrap",
    "vulkan-memory-allocator",
    "glfw3",
    {
      "name": "imgui",
      "features": [ "docking-experimental", "glfw-binding", "vulkan-binding" ]
    },
    {
      "name": "tracy",
      "features": [ "on-demand" ]
    },
    "nlohmann-json",
    "glm",
    "cli11",
    "catch2",
    "miniply",
    "tinyobjloader",
    "cgltf",
    "nativefiledialog-extended",
    "stb"
  ]
}
