# Run at build time (cmake -P). Writes the current git commit into a header so every benchmark
# result records exactly which code produced it. The file is only rewritten when it changes.
#   -DSOURCE_DIR=<repo>  -DOUTPUT=<header path>

set(commit "unversioned")
set(dirty "false")

find_program(GIT_EXECUTABLE git)
if(GIT_EXECUTABLE)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE head
        RESULT_VARIABLE head_result
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    if(head_result EQUAL 0)
        set(commit "${head}")
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no -- .
            WORKING_DIRECTORY "${SOURCE_DIR}"
            OUTPUT_VARIABLE status
            ERROR_QUIET)
        if(status)
            set(dirty "true")
        endif()
    endif()
endif()

file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT
"// Generated by cmake/GitInfo.cmake at build time. Do not edit.
#pragma once
#define THESIS_GIT_COMMIT \"${commit}\"
#define THESIS_GIT_DIRTY ${dirty}
")
